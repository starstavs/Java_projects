<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.tekwill.millionaire.controler.WelcomeController">


    <Label text="Who Wants To Be A Millionaire" textFill="#2f067c">
      <font>
         <Font name="System Bold" size="18.0" />
      </font>
      <VBox.margin>
         <Insets top="15.0" />
      </VBox.margin></Label>

    <Label text="Cum vă numiți">
      <font>
         <Font name="System Bold" size="16.0" />
      </font></Label>

    <TextField fx:id="playerName">
      <VBox.margin>
         <Insets left="200.0" right="200.0" />
      </VBox.margin></TextField>
   <Label text="Regulile jocului">
      <font>
         <Font name="System Bold" size="16.0" />
      </font>
   </Label>

    <TextArea fx:id="rulesArea" editable="false" prefHeight="168.0" prefWidth="600.0">
      <VBox.margin>
         <Insets left="25.0" right="25.0" />
      </VBox.margin>
      <padding>
         <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
      </padding></TextArea>

    <Button fx:id="okButton" text="Am înțăles" onAction="#startGame" />
   <padding>
      <Insets bottom="20.0" />
   </padding>

</VBox>
